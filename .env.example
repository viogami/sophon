# 已连接的 PostgreSQL (需 pgvector >= 0.7, 支持 sparsevec)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# CCSwitch 或其他 Anthropic Messages 兼容中转的连接信息。
# LLM_BASE_URL 填 CCSwitch 提供的完整 Anthropic 兼容地址（通常包含 /v1）。
LLM_API_KEY=your-ccswitch-key
LLM_BASE_URL=https://your-ccswitch-host/v1
LLM_MODEL=your-proxy-model-id

# 默认远程向量化：使用 OpenAI Embeddings 兼容接口，默认复用上述 key 和 base URL。
# 填 CCSwitch 已开通的 embedding 模型，例如 text-embedding-3-small 或 bge-m3。
# 如使用本地模型，请将 EMBEDDING_MODE 设置为 local，无需设置 EMBEDDING_MODEL。
EMBEDDING_MODE=remote
EMBEDDING_MODEL=your-embedding-model-id
